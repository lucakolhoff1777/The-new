# Datenbank (SQLite-Datei für Entwicklung; für Produktion z. B. PostgreSQL-URL eintragen)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="bitte-mit-`openssl rand -base64 32`-ersetzen"

# Anthropic (Claude) API-Key für die Berichtsgenerierung
ANTHROPIC_API_KEY=""
# Optional: Modell überschreiben (Standard: claude-sonnet-5)
ANTHROPIC_MODEL="claude-sonnet-5"
