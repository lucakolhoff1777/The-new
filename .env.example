# Datenbank (PostgreSQL - z. B. von Neon, Supabase oder Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="bitte-mit-`openssl rand -base64 32`-ersetzen"

# Anthropic (Claude) API-Key für die Berichtsgenerierung
ANTHROPIC_API_KEY=""
# Optional: Modell überschreiben (Standard: claude-sonnet-5)
ANTHROPIC_MODEL="claude-sonnet-5"
