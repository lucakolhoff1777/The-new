# =============================================================================
# Apache configuration (shared hosting: IONOS, Strato, All-Inkl, Hetzner …)
#
# The block that matters is the last one: it puts a real lock on the staff
# area. Everything above is housekeeping.
# =============================================================================

# --- HTTPS and canonical host ------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- Security headers --------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # The staff area must never be cached by a proxy or listed by a crawler.
  <FilesMatch "^plan\.html$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
</IfModule>

# --- Caching -----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg            "access plus 30 days"
  ExpiresByType image/png             "access plus 30 days"
  ExpiresByType image/svg+xml         "access plus 30 days"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# --- Nice URLs ---------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

ErrorDocument 404 /index.html

# =============================================================================
# THE STAFF AREA — the only thing that actually protects patient data.
#
# Setup, once:
#   1. On the server, outside the web root:
#        htpasswd -c /home/USER/.htpasswd praxis
#      (the tool ships with Apache; your hoster's control panel usually has a
#       "directory protection" dialog that writes the same file)
#   2. Put the real path into AuthUserFile below.
#   3. Uncomment the block.
#   4. Open /plan.html in a private window — you must be asked for a password
#      BEFORE any part of the page appears. If it does not ask, it is not
#      protected, and no patient data may go in.
# =============================================================================

#<Files "plan.html">
#  AuthType Basic
#  AuthName "Praxis Luca Kolhoff — interner Bereich"
#  AuthUserFile /home/USER/.htpasswd
#  Require valid-user
#</Files>

# Block direct access to the reference data as well — it is loaded by the
# public booking page, so it may only be locked down once the schedule lives
# behind an API instead of in a file.
