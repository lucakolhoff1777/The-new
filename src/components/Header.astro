---
const base = import.meta.env.BASE_URL;
const nav = [
  { href: `${base}`, label: 'Start' },
  { href: `${base}blog/`, label: 'Ratgeber' },
  { href: `${base}ueber-uns/`, label: 'Über uns' },
];
---
<header class="site-header">
  <div class="wrap">
    <a class="site-title" href={base}>Schreibtisch&amp;Fokus</a>
    <nav class="site-nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>
