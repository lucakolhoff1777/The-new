---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout
  title="Ratgeber"
  description="Alle Home-Office-Ratgeber und Kaufberatungen von Schreibtisch & Fokus."
>
  <h1>Ratgeber</h1>
  <p class="lede">Alle Artikel im Überblick.</p>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
        <p class="excerpt">{post.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
